gtk-color-scheme = "bg_color:#EBE9E1\nbase_color:#EBE9E1\nfg_color:#293238\ntext_color:#293238\nselected_bg_color:#356262\nselected_fg_color:#FBF8F1\ntooltip_bg_color:#EBE9E1\ntooltip_fg_color:#293238"

gtk-icon-sizes = "gtk-button=16,16"
style "macintosh-soft" {
 xthickness=2
 ythickness=2
 bg[NORMAL]=@bg_color
 bg[PRELIGHT]="#D7D9D4"
 bg[SELECTED]=@selected_bg_color
 bg[ACTIVE]="#D7D9D4"
 bg[INSENSITIVE]=@bg_color
 fg[NORMAL]=@fg_color
 fg[PRELIGHT]=@fg_color
 fg[SELECTED]=@selected_fg_color
 fg[ACTIVE]=@fg_color
 fg[INSENSITIVE]="#505D66"
 text[NORMAL]=@text_color
 text[SELECTED]=@selected_fg_color
 base[NORMAL]=@base_color
 base[SELECTED]=@selected_bg_color
 engine "murrine" {
  roundness=4
  contrast=1.0
  glazestyle=0
  glowstyle=0
  reliefstyle=0
 }
}
class "*" style "macintosh-soft"
