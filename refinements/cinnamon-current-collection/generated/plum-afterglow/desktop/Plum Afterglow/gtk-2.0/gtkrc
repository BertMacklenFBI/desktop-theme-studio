gtk-color-scheme = "bg_color:#211e29\nbase_color:#2d2838\nfg_color:#f0e7df\ntext_color:#f0e7df\nselected_bg_color:#584459\nselected_fg_color:#f0e7df\ntooltip_bg_color:#2d2838\ntooltip_fg_color:#f0e7df"

gtk-icon-sizes = "gtk-button=16,16"
style "plum-afterglow" {
 xthickness=2
 ythickness=2
 bg[NORMAL]=@bg_color
 bg[PRELIGHT]="#393244"
 bg[SELECTED]=@selected_bg_color
 bg[ACTIVE]="#393244"
 bg[INSENSITIVE]=@bg_color
 fg[NORMAL]=@fg_color
 fg[PRELIGHT]=@fg_color
 fg[SELECTED]=@selected_fg_color
 fg[ACTIVE]=@fg_color
 fg[INSENSITIVE]="#beb0bb"
 text[NORMAL]=@text_color
 text[SELECTED]=@selected_fg_color
 base[NORMAL]=@base_color
 base[SELECTED]=@selected_bg_color
 engine "murrine" {
  roundness=5
  contrast=1.0
  glazestyle=0
  glowstyle=0
  reliefstyle=0
 }
}
class "*" style "plum-afterglow"
