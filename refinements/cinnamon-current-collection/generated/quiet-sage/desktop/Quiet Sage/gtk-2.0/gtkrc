gtk-color-scheme = "bg_color:#242722\nbase_color:#2e332d\nfg_color:#ede8dc\ntext_color:#ede8dc\nselected_bg_color:#52684b\nselected_fg_color:#ede8dc\ntooltip_bg_color:#2e332d\ntooltip_fg_color:#ede8dc"

gtk-icon-sizes = "gtk-button=16,16"
style "quiet-sage" {
 xthickness=2
 ythickness=2
 bg[NORMAL]=@bg_color
 bg[PRELIGHT]="#383f35"
 bg[SELECTED]=@selected_bg_color
 bg[ACTIVE]="#383f35"
 bg[INSENSITIVE]=@bg_color
 fg[NORMAL]=@fg_color
 fg[PRELIGHT]=@fg_color
 fg[SELECTED]=@selected_fg_color
 fg[ACTIVE]=@fg_color
 fg[INSENSITIVE]="#b3b6a7"
 text[NORMAL]=@text_color
 text[SELECTED]=@selected_fg_color
 base[NORMAL]=@base_color
 base[SELECTED]=@selected_bg_color
 engine "murrine" {
  roundness=4
  contrast=1.0
  glazestyle=0
  glowstyle=0
  reliefstyle=0
 }
}
class "*" style "quiet-sage"
