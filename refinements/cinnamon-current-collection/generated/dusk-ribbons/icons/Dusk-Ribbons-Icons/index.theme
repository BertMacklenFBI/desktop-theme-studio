[Icon Theme]
Name=Dusk Ribbons Icons
Comment=Palette-coordinated applications and folders
Inherits=Papirus-Dark,hicolor
Directories=scalable/apps,scalable/places,scalable/devices,scalable/mimetypes

[scalable/apps]
Size=64
Type=Scalable
MinSize=24
MaxSize=256
Context=Applications

[scalable/places]
Size=64
Type=Scalable
MinSize=24
MaxSize=256
Context=Places

[scalable/devices]
Size=64
Type=Scalable
MinSize=24
MaxSize=256
Context=Devices

[scalable/mimetypes]
Size=64
Type=Scalable
MinSize=24
MaxSize=256
Context=MimeTypes
