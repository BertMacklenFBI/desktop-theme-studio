gtk-color-scheme = "bg_color:#E9EBE6\nbase_color:#E9EBE6\nfg_color:#304957\ntext_color:#304957\nselected_bg_color:#354D64\nselected_fg_color:#E9EBE6\ntooltip_bg_color:#E9EBE6\ntooltip_fg_color:#304957"

gtk-icon-sizes = "gtk-button=16,16"
style "macintosh-soft" {
 xthickness=2
 ythickness=2
 bg[NORMAL]=@bg_color
 bg[PRELIGHT]="#CBD7DA"
 bg[SELECTED]=@selected_bg_color
 bg[ACTIVE]="#CBD7DA"
 bg[INSENSITIVE]=@bg_color
 fg[NORMAL]=@fg_color
 fg[PRELIGHT]=@fg_color
 fg[SELECTED]=@selected_fg_color
 fg[ACTIVE]=@fg_color
 fg[INSENSITIVE]="#475F6C"
 text[NORMAL]=@text_color
 text[SELECTED]=@selected_fg_color
 base[NORMAL]=@base_color
 base[SELECTED]=@selected_bg_color
 engine "murrine" {
  roundness=4
  contrast=1.0
  glazestyle=0
  glowstyle=0
  reliefstyle=0
 }
}
class "*" style "macintosh-soft"
