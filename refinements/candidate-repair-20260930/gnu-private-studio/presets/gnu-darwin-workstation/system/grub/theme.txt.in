# @theme_name@ -- GRUB gfxmenu theme (generated by generate.py; do not hand-edit theme.txt)
# Sized for the native 2880x1800 framebuffer (GRUB_GFXMODE=auto): all numbers are 2x.
title-text: ""
desktop-image: "background.png"
desktop-image-scale-method: "stretch"
desktop-color: "@desktop@"
terminal-font: "GNU-Darwin Workstation Mono Regular 28"
terminal-left: "0"
terminal-top: "0"
terminal-width: "100%"
terminal-height: "100%"
terminal-border: "0"

# Text identity; no fabricated project mark.
+ label {
  left = 20%
  top = 32%
  width = 60%
  align = "center"
  font = "GNU-Darwin Workstation Bold 28"
  color = "@selection_foreground@"
  text = "@theme_name@"
}

# square gray card with slate selection
+ boot_menu {
  left = 50%-560
  top = 50%
  width = 1120
  height = 28%
  item_font = "GNU-Darwin Workstation Regular 28"
  selected_item_font = "GNU-Darwin Workstation Bold 28"
  item_color = "@foreground@"
  selected_item_color = "@selection_foreground@"
  icon_width = 0
  icon_height = 0
  item_icon_space = 0
  item_height = 72
  item_padding = 14
  item_spacing = 10
  menu_pixmap_style = "menu_*.png"
  selected_item_pixmap_style = "select_*.png"
  scrollbar = true
  scrollbar_width = 12
  scrollbar_slice = "east"
  scrollbar_right_pad = 5
  scrollbar_frame = "bar_*.png"
  scrollbar_thumb = "hl_*.png"
}

# countdown bar
+ progress_bar {
  id = "__timeout__"
  left = 50%-300
  top = 88%
  width = 600
  height = 12
  show_text = false
  text = ""
  bar_style = "bar_*.png"
  highlight_style = "hl_*.png"
  highlight_overlay = true
}

# countdown label
+ label {
  id = "__timeout__"
  left = 35%
  top = 90%+8
  width = 30%
  align = "center"
  font = "GNU-Darwin Workstation Regular 28"
  color = "@muted@"
  text = "@theme_name@ · starting in %d seconds"
}
