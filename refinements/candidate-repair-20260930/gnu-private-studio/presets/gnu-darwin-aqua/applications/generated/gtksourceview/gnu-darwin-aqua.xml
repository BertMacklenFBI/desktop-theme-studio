<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="gnu-darwin-aqua" name="GNU-Darwin Aqua" version="1.0"><author>Desktop Theme Studio</author><description>Light Aqua editor colors with blue selection.</description>
<style name="text" foreground="#202328" background="#EEF0F2"/>
<style name="selection" foreground="#FFFFFF" background="#245FA8"/>
<style name="cursor" foreground="#245FA8"/>
<style name="current-line" background="#E2E4E7"/><style name="line-numbers" foreground="#535A64" background="#E2E4E7"/>
<style name="bracket-match" foreground="#FFFFFF" background="#265098" bold="true"/>
<style name="search-match" foreground="#FFFFFF" background="#805200"/>
<style name="def:comment" foreground="#535A64" italic="true"/><style name="def:keyword" foreground="#245FA8" bold="true"/>
<style name="def:string" foreground="#276235"/><style name="def:number" foreground="#265098"/><style name="def:type" foreground="#17666E"/>
<style name="def:function" foreground="#2864AC"/><style name="def:preprocessor" foreground="#805200"/><style name="def:error" foreground="#A52925"/>
</style-scheme>
