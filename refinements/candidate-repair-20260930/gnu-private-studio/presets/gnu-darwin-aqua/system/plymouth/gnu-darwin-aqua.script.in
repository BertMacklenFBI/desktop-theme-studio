// @theme_name@ — Plymouth "script" theme.
// Aqua wallpaper, slim blue progress pill, opaque silver unlock
// dialog (lock glyph, pill entry, blue bullets, caps-lock badge), question
// entry with blinking caret, opaque message band. Every size is a fraction of the
// window so the layout is identical at DeviceScale 1 (2880x1800) and 2 (1440x900).

Window.SetBackgroundTopColor(@desktop_rgb@);
Window.SetBackgroundBottomColor(@desktop_rgb@);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
ui = screen_h / 1800;                       // 1.0 native, 0.5 at DeviceScale 2

// Pango point sizes, derived from the window height so they degrade with scale.
font_prompt = Math.Int(26 * ui);
if (font_prompt < 12) font_prompt = 12;
font_msg = Math.Int(22 * ui);
if (font_msg < 11) font_msg = 11;
font_title = font_msg;
font_prompt_desc = "Liberation Sans " + font_prompt;
font_msg_desc = "Liberation Sans " + font_msg;
font_title_desc = "Liberation Sans " + font_title;

mode = Plymouth.GetMode();
booting = (mode == "boot");

// ------------------------------------------------------------------ wallpaper
bg.source = Image("wallpaper.png");
bg.scale = screen_w / bg.source.GetWidth();
if (bg.source.GetHeight() * bg.scale > screen_h)
    bg.scale = screen_h / bg.source.GetHeight();
bg.image = bg.source.Scale(bg.source.GetWidth() * bg.scale, bg.source.GetHeight() * bg.scale);
bg.sprite = Sprite(bg.image);
bg.sprite.SetPosition((screen_w - bg.image.GetWidth()) / 2, (screen_h - bg.image.GetHeight()) / 2, -10);

// The original wallpaper carries GNU-Darwin lettering. The installer may replace the
// marker line below with a guarded logo.png overlay (22% of the height, centred at 40%,
// exactly where the wallpaper already carries the mark, so the overlay is normally unnecessary); default off.
// @OPTIONAL_LOGO@

// ------------------------------------------------------------------ title
title.image = Image.Text("@theme_name@", @foreground_rgb@, 1.0, font_title_desc, "center");
title.back = Sprite(Image("title-surface.png").Scale(title.image.GetWidth()+48, title.image.GetHeight()+24));
title.back.SetPosition((screen_w-title.image.GetWidth())/2-24, screen_h*0.615-12, 1);
title.sprite = Sprite(title.image);
title.sprite.SetPosition((screen_w - title.image.GetWidth()) / 2, screen_h * 0.615, 2);

// ------------------------------------------------------------------ 3-slice bands
fun band_new(stem, z) {
    band.cap_l = Image(stem + "-cap-l.png");
    band.cap_r = Image(stem + "-cap-r.png");
    band.mid = Image(stem + ".png");
    band.l = Sprite();
    band.m = Sprite();
    band.r = Sprite();
    band.z = z;
    band.visible = 0;
    band.l.SetOpacity(0);
    band.m.SetOpacity(0);
    band.r.SetOpacity(0);
    return band;
}

fun band_layout(band, x, y, w, h) {
    bcap = h * band.cap_l.GetWidth() / band.cap_l.GetHeight();
    if (bcap * 2 > w) bcap = w / 2;
    band.l.SetImage(band.cap_l.Scale(bcap, h));
    band.l.SetPosition(x, y, band.z);
    band.m.SetImage(band.mid.Scale(w - 2 * bcap, h));
    band.m.SetPosition(x + bcap, y, band.z);
    band.r.SetImage(band.cap_r.Scale(bcap, h));
    band.r.SetPosition(x + w - bcap, y, band.z);
}

fun band_show(band, on) {
    if (band.visible == on) return;
    band.visible = on;
    band.l.SetOpacity(on);
    band.m.SetOpacity(on);
    band.r.SetOpacity(on);
}

// ------------------------------------------------------------------ progress
bar_w = screen_w * 0.20;
bar_h = Math.Int(bar_w / 48);               // track pixmap is 48:1, so the scale is uniform
if (bar_h < 4) bar_h = 4;
bar_x = (screen_w - bar_w) / 2;
bar_y = screen_h * 0.78 - bar_h / 2;
cap_w = Math.Int(bar_h / 2);
if (cap_w < 1) cap_w = 1;
hl_h = Math.Int(2 * ui);
if (hl_h < 1) hl_h = 1;
hl_gap = Math.Int(2 * ui);
if (hl_gap < 1) hl_gap = 1;

bar.highlight = Sprite(Image("progress-highlight.png").Scale(bar_w - bar_h, hl_h));
bar.highlight.SetPosition(bar_x + bar_h / 2, bar_y - hl_gap, 2);
bar.track = Sprite(Image("progress-track.png").Scale(bar_w, bar_h));
bar.track.SetPosition(bar_x, bar_y, 2);
bar.fill_source = Image("progress-fill.png");
bar.cap_l = Sprite(Image("progress-cap-l.png").Scale(cap_w, bar_h));
bar.cap_l.SetPosition(bar_x, bar_y, 3);
bar.cap_r_source = Image("progress-cap-r.png").Scale(cap_w, bar_h);
bar.cap_r = Sprite(bar.cap_r_source);
bar.fill = Sprite();
bar.fill.SetPosition(bar_x + cap_w, bar_y, 3);
bar.progress = 0;
bar.visible = -1;
bar.wanted = 1;                             // hidden while a prompt owns the slot

fun bar_apply(width) {
    if (width < 2 * cap_w) width = 2 * cap_w;
    if (width > bar_w) width = bar_w;
    bar.fill.SetImage(bar.fill_source.Scale(width - 2 * cap_w, bar_h));
    bar.cap_r.SetPosition(bar_x + width - cap_w, bar_y, 3);
}

fun bar_show(on) {
    if (!booting) on = 0;                   // no progress in shutdown / reboot / updates
    if (bar.visible == on) return;
    bar.visible = on;
    bar.highlight.SetOpacity(on);
    bar.track.SetOpacity(on);
    bar.fill.SetOpacity(on);
    bar.cap_l.SetOpacity(on);
    bar.cap_r.SetOpacity(on);
}

fun progress_callback(duration, progress) {
    if (!booting) return;
    if (progress < 0) progress = 0;
    if (progress > 1) progress = 1;
    bar.progress = progress;
    bar_apply(bar_w * progress);
}

bar_apply(0);
bar_show(bar.wanted);
Plymouth.SetBootProgressFunction(progress_callback);

// ------------------------------------------------------------------ unlock dialog
field_h = Math.Int(screen_h * 0.040);
field_w = Math.Int(field_h * 640 / 72);
lock_d = field_h;
caps_d = Math.Int(field_h * 56 / 72);
bullet_d = Math.Int(field_h * 22 / 72);
caret_h = Math.Int(field_h * 40 / 72);
caret_w = Math.Int(field_h * 4 / 72);
if (caret_w < 1) caret_w = 1;
icon_gap = Math.Int(screen_h * 0.012);
pad_x = Math.Int(screen_h * 0.020);
pad_y = Math.Int(screen_h * 0.014);
gap = Math.Int(screen_h * 0.010);
row_h = Math.Int(font_prompt * 1.6);
row_w = lock_d + icon_gap + field_w + icon_gap + caps_d;
card_min_w = row_w + 2 * pad_x;
card_h = pad_y + row_h + gap + field_h + pad_y;
card_y = screen_h * 0.785 - field_h / 2 - gap - row_h - pad_y;
field_pad = Math.Int(field_h * 0.40);
field_inner_w = field_w - 2 * field_pad;
bullet_pitch = Math.Int(bullet_d * 1.5);
bullet_max = Math.Int(field_inner_w / bullet_pitch);

dialog = band_new("prompt-surface", 4);
dialog.text = Sprite();
dialog.text.SetOpacity(0);
dialog.lock = Sprite(Image("lock.png").Scale(lock_d, lock_d));
dialog.lock.SetOpacity(0);
dialog.field = Sprite(Image("entry.png").Scale(field_w, field_h));
dialog.field.SetOpacity(0);
dialog.caps = Sprite(Image("capslock.png").Scale(caps_d, caps_d));
dialog.caps.SetOpacity(0);
dialog.caps_on = 0;
dialog.caret = Sprite(Image("caret.png").Scale(caret_w, caret_h));
dialog.caret.SetOpacity(0);
dialog.caret_on = 0;
dialog.entry = Sprite();
dialog.entry.SetOpacity(0);
dialog.mode = "";                           // "", "password" or "question"
dialog.bullets = 0;
dialog.field_x = 0;
dialog.field_y = 0;
bullet.image = Image("bullet.png").Scale(bullet_d, bullet_d);
for (i = 0; i < bullet_max; i++) {
    bullet.dot[i] = Sprite(bullet.image);
    bullet.dot[i].SetOpacity(0);
}

fun fit_width(image, limit) {
    if (image.GetWidth() > limit)
        image = image.Scale(limit, image.GetHeight() * limit / image.GetWidth());
    return image;
}

fun bullets_show(count) {
    if (count > bullet_max) count = bullet_max;
    dialog.bullets = count;
    for (i = 0; i < bullet_max; i++) {
        if (i < count) {
            bullet.dot[i].SetPosition(dialog.field_x + field_pad + i * bullet_pitch,
                                      dialog.field_y + (field_h - bullet_d) / 2, 6);
            bullet.dot[i].SetOpacity(1);
        } else {
            bullet.dot[i].SetOpacity(0);
        }
    }
}

fun dialog_open(prompt_text) {
    text_limit = screen_w * 0.80 - 2 * pad_x;
    image = fit_width(Image.Text(prompt_text, @foreground_rgb@, 1.0, font_prompt_desc, "center"), text_limit);
    card_w = image.GetWidth() + 2 * pad_x;
    if (card_w < card_min_w) card_w = card_min_w;
    card_x = (screen_w - card_w) / 2;
    band_layout(dialog, card_x, card_y, card_w, card_h);
    band_show(dialog, 1);
    row_y = card_y + pad_y;
    dialog.text.SetImage(image);
    dialog.text.SetPosition((screen_w - image.GetWidth()) / 2, row_y + (row_h - image.GetHeight()) / 2, 6);
    dialog.text.SetOpacity(1);
    dialog.field_y = row_y + row_h + gap;
    inner_x = card_x + (card_w - row_w) / 2;
    dialog.lock.SetPosition(inner_x, dialog.field_y, 5);
    dialog.lock.SetOpacity(1);
    dialog.field_x = inner_x + lock_d + icon_gap;
    dialog.field.SetPosition(dialog.field_x, dialog.field_y, 5);
    dialog.field.SetOpacity(1);
    dialog.caps.SetPosition(dialog.field_x + field_w + icon_gap, dialog.field_y + (field_h - caps_d) / 2, 5);
    bar_show(0);
}

fun dialog_close() {
    band_show(dialog, 0);
    dialog.text.SetOpacity(0);
    dialog.lock.SetOpacity(0);
    dialog.field.SetOpacity(0);
    dialog.caps.SetOpacity(0);
    dialog.caps_on = 0;
    dialog.caret.SetOpacity(0);
    dialog.caret_on = 0;
    dialog.entry.SetOpacity(0);
    dialog.mode = "";
    bullets_show(0);
    bar_show(bar.wanted);
}

fun display_password_callback(prompt_text, bullets) {
    if (prompt_text == "") prompt_text = "Password";
    dialog.mode = "password";
    dialog.entry.SetOpacity(0);
    dialog.caret.SetOpacity(0);
    dialog.caret_on = 0;
    dialog_open(prompt_text);
    bullets_show(bullets);
}

fun display_question_callback(prompt_text, entry_text) {
    if (prompt_text == "") prompt_text = "Question";
    dialog.mode = "question";
    bullets_show(0);
    dialog_open(prompt_text);
    x = dialog.field_x + field_pad;
    if (entry_text != "") {
        limit = field_inner_w - caret_w - Math.Int(field_h * 0.10);
        image = fit_width(Image.Text(entry_text, @foreground_rgb@, 1.0, font_prompt_desc, "left"), limit);
        dialog.entry.SetImage(image);
        dialog.entry.SetPosition(x, dialog.field_y + (field_h - image.GetHeight()) / 2, 6);
        dialog.entry.SetOpacity(1);
        x = x + image.GetWidth() + Math.Int(field_h * 0.06);
    } else {
        dialog.entry.SetOpacity(0);
    }
    dialog.caret.SetPosition(x, dialog.field_y + (field_h - caret_h) / 2, 7);
    dialog.caret.SetOpacity(1);
    dialog.caret_on = 1;
    dialog.tick = 0;
}

fun display_normal_callback() {
    dialog_close();
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// ------------------------------------------------------------------ message band
band_h = Math.Int(screen_h * 0.05);
band_y = screen_h * 0.915;
message = band_new("message-surface", 4);
message.text = Sprite();
message.text.SetOpacity(0);
message.current = "";

fun message_show(text) {
    message.current = text;
    if (text == "") {
        band_show(message, 0);
        message.text.SetOpacity(0);
        return;
    }
    image = fit_width(Image.Text(text, @muted_rgb@, 1.0, font_msg_desc, "center"), screen_w * 0.80 - 2 * pad_x);
    band_w = image.GetWidth() + 2 * pad_x;
    if (band_w < screen_w * 0.24) band_w = screen_w * 0.24;
    band_layout(message, (screen_w - band_w) / 2, band_y, band_w, band_h);
    band_show(message, 1);
    message.text.SetImage(image);
    message.text.SetPosition((screen_w - image.GetWidth()) / 2, band_y + (band_h - image.GetHeight()) / 2, 5);
    message.text.SetOpacity(1);
}

fun display_message_callback(text) {
    message_show(text);
}

fun hide_message_callback(text) {
    message_show("");
}

// "fsck:<device>:<percent>" arrives from the initramfs disk check; anything else
// is shown verbatim on the same band.
fun update_status_callback(status) {
    if (status == "" || status == "normal") return;
    if (status.SubString(0, 5) == "fsck:") {
        rest = status.SubString(5, status.Length());
        device = "";
        percent = "";
        seen = 0;
        for (i = 0; i < rest.Length(); i++) {
            c = rest.CharAt(i);
            if (c == ":" && seen == 0) {
                seen = 1;
            } else if (seen == 0) {
                device = device + c;
            } else {
                percent = percent + c;
            }
        }
        line = "Checking disk " + device;
        if (percent != "") line = line + " (" + percent + "%)";
        message_show(line);
        return;
    }
    message_show(status);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
Plymouth.SetUpdateStatusFunction(update_status_callback);

// ------------------------------------------------------------------ refresh: caret + caps lock
dialog.tick = 0;

fun refresh_callback() {
    if (dialog.mode == "") return;
    caps = Plymouth.GetCapslockState();
    if (caps) caps = 1; else caps = 0;
    if (caps != dialog.caps_on) {
        dialog.caps_on = caps;
        dialog.caps.SetOpacity(caps);
    }
    if (dialog.mode == "question") {
        dialog.tick = dialog.tick + 1;
        if (dialog.tick >= 25) {
            dialog.tick = 0;
            if (dialog.caret_on) dialog.caret_on = 0; else dialog.caret_on = 1;
            dialog.caret.SetOpacity(dialog.caret_on);
        }
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

// ------------------------------------------------------------------ quit
fun quit_callback() {
    // Nothing to tear down: the compositor takes over from the last frame.
}

Plymouth.SetQuitFunction(quit_callback);
