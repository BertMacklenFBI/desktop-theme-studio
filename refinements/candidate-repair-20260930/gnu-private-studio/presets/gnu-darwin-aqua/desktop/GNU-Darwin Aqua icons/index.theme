[Icon Theme]
Name=GNU-Darwin Aqua icons
Comment=Aqua silver tiles and folders over Papirus-Dark
Inherits=Papirus,hicolor
Directories=scalable/apps,scalable/places,scalable/devices,scalable/mimetypes

[scalable/apps]
Size=64
Type=Scalable
MinSize=24
MaxSize=256
Context=Applications

[scalable/places]
Size=64
Type=Scalable
MinSize=24
MaxSize=256
Context=Places

[scalable/devices]
Size=64
Type=Scalable
MinSize=24
MaxSize=256
Context=Devices

[scalable/mimetypes]
Size=64
Type=Scalable
MinSize=24
MaxSize=256
Context=MimeTypes
